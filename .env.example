NODE_ENV=development

# PostgreSQL (docker compose). 로컬 Postgres(5432)와 충돌하지 않도록 호스트 포트는 5433.
# PG_PORT를 바꾸면 DATABASE_URL의 포트도 함께 바꾼다.
PG_PORT=5433
DATABASE_URL=postgresql://bo:bo@localhost:5433/bo

# 반드시 임의의 긴 문자열(32자 이상)로 교체한다. 아래 예시 값은 NODE_ENV=production에서 거부된다.
JWT_SECRET=change-me-to-a-random-string-of-32-chars-or-more
ACCESS_TTL_SEC=900
REFRESH_TTL_SEC=604800

PORT=4000
WEB_ORIGIN=http://localhost:3000
# API_ORIGIN, MEDIA_ORIGIN은 Next(apps/web)의 rewrite 대상이다. Next는 루트 .env를 읽지 않으므로
# 기본값과 다를 때는 apps/web/.env.local 또는 프로세스 환경 변수로 지정한다(이 파일은 참고용).
API_ORIGIN=http://localhost:4000

# 시드 데모 계정 공통 비밀번호
SEED_PASSWORD=demo1234!
# 공개 데모 배포에서 true로 둔다. 데모 계정(admin/manager/viewer@demo.com)의 역할·활성 상태 변경을 막는다(이름 변경은 허용).
DEMO_MODE=false

# 리버스 프록시 홉 수(Express trust proxy). 0이면 X-Forwarded-For를 믿지 않는다(로컬 기본값).
# 프록시 뒤에 배포할 때만 실제 홉 수로 올린다. 실제보다 크게 잡으면 클라이언트가 IP를 위조할 수 있다.
TRUST_PROXY=0
# 로그인 시도 제한: (IP, 이메일)마다 TTL(초) 동안 LIMIT회까지 허용한다. 성공한 로그인도 센다.
LOGIN_THROTTLE_LIMIT=10
LOGIN_THROTTLE_TTL_SEC=600

# S3 호환 저장소 (docker compose --profile storage, adobe/s3mock). 비우면 S3_ENDPOINT는 AWS 기본값.
S3_ENDPOINT=http://localhost:9090
S3_REGION=us-east-1
S3_BUCKET=bo-media
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=local
S3_FORCE_PATH_STYLE=true
MEDIA_ORIGIN=http://localhost:9090/bo-media
