NODE_ENV=development

# PostgreSQL (docker compose). 로컬 Postgres(5432)와 충돌하지 않도록 호스트 포트는 5433.
# PG_PORT를 바꾸면 DATABASE_URL의 포트도 함께 바꾼다.
PG_PORT=5433
DATABASE_URL=postgresql://bo:bo@localhost:5433/bo

# 반드시 임의의 긴 문자열(32자 이상)로 교체한다.
JWT_SECRET=change-me-to-a-random-string-of-32-chars-or-more
ACCESS_TTL_SEC=900
REFRESH_TTL_SEC=604800

PORT=4000
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000

# 시드 데모 계정 공통 비밀번호
SEED_PASSWORD=demo1234!
